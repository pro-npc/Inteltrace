data/
backups/
*.db
*.db-wal
*.db-shm

# logs
npm-debug.log*
*.log

# verification harness bundles (regenerated by `npm run verify:*`)
scripts/.verify-golden.mjs
scripts/.verify-patterns.mjs

# os
.DS_Store
Thumbs.db
