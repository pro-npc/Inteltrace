{
  "name": "inteltrace-forensics",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "astro build",
    "preview": "node ./dist/server/entry.mjs",
    "serve": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "verify:store": "tsx scripts/verify-store.ts",
    "verify:golden": "esbuild scripts/verify-golden.ts --bundle --platform=node --format=esm --outfile=scripts/.verify-golden.mjs --log-level=warning && node scripts/.verify-golden.mjs",
    "verify:dynamic": "tsx scripts/test-dynamic.ts",
    "verify": "npm run check && npm run verify:store && npm run verify:golden",
    "backup": "node scripts/backup.mjs",
    "reset-demo": "node scripts/reset_demo.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^9.1.0",
    "@astrojs/tailwind": "^5.1.5",
    "astro": "^5.3.0",
    "gsap": "^3.12.7",
    "lucide": "^0.475.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "dotenv": "^17.4.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.13"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
