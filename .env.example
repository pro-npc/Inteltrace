# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
# Read by `astro dev`, by `astro build`, and by the standalone server
# (`npm run serve`). `process.env` wins over this file, so the shell that
# launches the server can override any value.

# ── Required ─────────────────────────────────────────────────────────────────

# Session signing secret. Any long random string.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start without it: an absent secret would leave every
# session cookie unsigned.
SESSION_SECRET="change-me-to-a-long-random-hex-string"

# ── Strongly recommended ─────────────────────────────────────────────────────

# AES-GCM key for encryption at rest. Case content is stored in the clear when
# this is unset. Generate the same way as SESSION_SECRET.
# WARNING: changing this key makes every existing case undecryptable.
ENCRYPTION_KEY="change-me-to-a-long-random-hex-string"

# ── Optional ─────────────────────────────────────────────────────────────────

# Where the SQLite database lives. Relative paths resolve against the project
# root. Defaults to `data`, i.e. ./data/inteltrace.db
DATA_DIR="data"

# Google Gemini (AI Studio) — powers the forensic copilot. Without it the
# copilot endpoint returns an error; everything else works.
GEMINI_API_KEY=""

# Etherscan — live Ethereum reads. The fixture fallback covers the demo case.
ETHERSCAN_API_KEY=""

# OmniRoute — optional AI enrichment during analysis. Skipped when unset.
OMNIROUTE_API_KEY=""
OMNIROUTE_BASE_URL="http://localhost:20128/v1"
OMNIROUTE_PRIMARY_MODEL="antigravity/gemini-3.7-flash-high"
OMNIROUTE_VALIDATOR_MODEL="antigravity/gemini-3.7-flash-low"
