        </div>
        <div style="font-size:0.68rem;color:#8BA3C0;margin-bottom:8px">${loc.address}</div>
        <div style="display:flex;flex-direction:column;gap:4px;border-top:1px solid rgba(255,255,255,0.08);padding-top:6px">
          ${loc.details.map(d => `<div style="font-size:0.68rem;color:#F0F6FF;line-height:1.4">• ${d}</div>`).join('')}
        </div>
      </div>
    `;

    marker.bindPopup(popupHtml);

    // Geodesic Range Halos
    L.circle([loc.lat, loc.lng], {
      radius: loc.color === '#FF4757' ? 12000 : loc.color === '#00D4FF' ? 8000 : 6000,
      color: loc.color,
      weight: 1,
      fillColor: loc.color,
      fillOpacity: 0.05,
      dashArray: '4, 4'
    }).addTo(leafletMap);
  });

  // Overnight Return Corridor (Goa → Mumbai, ~580 km over ~9 h — curved arc with coastal waypoints)
  const GOLDEN_TRAJECTORY = [
    [15.4909, 73.8278], // Panaji Goa (23:41 PM)
    [16.1000, 73.6500], // Malvan coast
    [16.9900, 73.3000], // Ratnagiri
    [17.7500, 73.2000], // Chiplun offshore
    [18.6000, 72.9000], // Alibaug
    [19.1363, 72.8277]  // Andheri West Mumbai (08:55 AM)
  ];

  const trajectoryPoints = (ISLAND.trajectory && ISLAND.trajectory.length >= 2) ? ISLAND.trajectory : (ISLAND.isGolden ? GOLDEN_TRAJECTORY : []);

  if (trajectoryPoints.length >= 2) {
    const polyline = L.polyline(trajectoryPoints, {
      color: '#FF4757',
      weight: 3.5,
      dashArray: '8, 8',
      opacity: 0.95
    }).addTo(leafletMap);

    // Attached Speed Telemetry Floating Badge (golden corridor only)
    if (ISLAND.isGolden) {
      polyline.bindTooltip(
        '<div style="font-family:JetBrains Mono,monospace;font-weight:700;color:#FF4757;font-size:0.75rem;background:rgba(4,9,20,0.95);padding:5px 10px;border:1.5px solid #FF4757;border-radius:6px;box-shadow:0 0 15px rgba(255,71,87,0.4)">🌙 GOA → MUMBAI · OVERNIGHT RETURN (~580 KM)</div>',
        { permanent: true, direction: 'center', className: 'vector-tooltip' }
      );
    }
  }

  // Auto-fit perfectly to the entire corridor / dynamic pin extent
  fitDefault();
}

function setMapLayer(type) {
  if (!leafletMap) return;
  const btnDark = document.getElementById('btn-layer-dark');
  const btnSat = document.getElementById('btn-layer-sat');
  const btnStreet = document.getElementById('btn-layer-street');

  [btnDark, btnSat, btnStreet].forEach(b => { if (b) b.classList.remove('active'); });

  if (tileLayerDark && leafletMap.hasLayer(tileLayerDark)) leafletMap.removeLayer(tileLayerDark);
  if (tileLayerSat && leafletMap.hasLayer(tileLayerSat)) leafletMap.removeLayer(tileLayerSat);
  if (tileLayerStreet && leafletMap.hasLayer(tileLayerStreet)) leafletMap.removeLayer(tileLayerStreet);

  if (type === 'sat') {
    tileLayerSat.addTo(leafletMap);
    if (btnSat) btnSat.classList.add('active');
  } else if (type === 'street') {
    tileLayerStreet.addTo(leafletMap);
    if (btnStreet) btnStreet.classList.add('active');
  } else {
    tileLayerDark.addTo(leafletMap);
    if (btnDark) btnDark.classList.add('active');
  }
}

function mapFocus(target) {
  if (!leafletMap) return;
  if (target === 'vector') {
    leafletMap.flyToBounds([[15.3, 72.6], [19.3, 74.1]], { duration: 1.2 });
  } else if (target === 'mumbai') {
    leafletMap.flyTo([19.16, 72.84], 12, { duration: 1.2 });
  } else if (target === 'goa') {
    leafletMap.flyTo([15.50, 73.80], 12, { duration: 1.2 });
  } else {
    fitDefault({ duration: 1.2 });
  }
}

function flyToPin(lat, lng, label) {
