const nodeDetails = (ISLAND.nodeDetails && Object.keys(ISLAND.nodeDetails).length) ? ISLAND.nodeDetails : GOLDEN_NODE_DETAILS;

function nodeClick(id) {
  const d = nodeDetails[id];
  const content = document.getElementById('node-content');
  const hdr = document.getElementById('node-header');
  const body = document.getElementById('node-body');

  function safeText(str) {
    return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  if (!d || !content || !hdr || !body) return;

  content.classList.remove('hidden');

  const safeName = safeText(d.name);
  const safeRole = safeText(d.role);
  const initials = safeText(d.name.split(' ').map(w=>w[0]).join('').slice(0,2));
  const safeRisk = safeText(d.risk);

  hdr.innerHTML = `
    <div style="display:flex;align-items:center;gap:9px;margin-bottom:4px">
      <div style="width:32px;height:32px;border-radius:50%;background:${d.color}15;border:2px solid ${d.color};display:flex;align-items:center;justify-content:center;font-size:0.7rem;font-weight:700;color:${d.color}">
        ${initials}
      </div>
      <div style="flex:1">
        <div style="font-size:0.86rem;font-weight:600;color:var(--text-1)">${safeName}</div>
        <div style="font-size:0.66rem;color:var(--text-3)">${safeRole}</div>
      </div>
      <span class="badge b-${d.risk.toLowerCase()==='traced'?'active':d.risk.toLowerCase()==='suspicious'?'medium':'high'}">${safeRisk}</span>
    </div>
  `;

  body.innerHTML = d.facts.map(f => `<div style="background:rgba(255,255,255,0.03);border:1px solid var(--border-1);border-radius:6px;padding:6px 9px;font-size:0.72rem;color:var(--text-2)">${safeText(f)}</div>`).join('');

  // Interactive Spider Web Highlighting
  const allNodes = document.querySelectorAll('.spider-node');
  const allEdges = document.querySelectorAll('.spider-edge');
  
  // Find connected nodes
  const connectedNodeIds = new Set();
  connectedNodeIds.add(id);
  allEdges.forEach(e => {
    const fromId = e.getAttribute('data-from');
    const toId = e.getAttribute('data-to');
    if (fromId === id || toId === id) {
      connectedNodeIds.add(fromId);
      connectedNodeIds.add(toId);
    }
  });

  // Dim unrelated nodes and edges
  allNodes.forEach(n => {
    const nId = n.getAttribute('data-id');
    n.style.opacity = connectedNodeIds.has(nId) ? '1' : '0.15';
  });
  allEdges.forEach(e => {
    const fromId = e.getAttribute('data-from');
    const toId = e.getAttribute('data-to');
    e.style.opacity = (fromId === id || toId === id) ? '1' : '0.05';
  });
}

