// Suspect Movement Playback Simulation (golden literal fallback)
const GOLDEN_SIM_STEPS = [
  { lat: 19.1860, lng: 72.8485, t: 'March 15 · 09:14 AM', note: 'Malad Tower (Call 127s)' },
  { lat: 19.1860, lng: 72.8485, t: 'March 15 · 11:02 AM', note: 'Malad Tower (Call to Rohan)' },
  { lat: 15.5170, lng: 73.7650, t: 'March 15 · 23:30 PM', note: 'Candolim Beach (Instagram Geotag)' },
  { lat: 15.4909, lng: 73.8278, t: 'March 15 · 23:41 PM', note: 'Panaji Tower (Call 302s)' },
  { lat: 19.1363, lng: 72.8277, t: 'March 16 · 08:55 AM', note: 'Andheri West (Morning SMS Jump)' }
];
const simRouteSteps = ISLAND.isGolden ? GOLDEN_SIM_STEPS : (ISLAND.simSteps || []);
let simIndex = 0;

function toggleRouteSimulation() {
  const icon = document.getElementById('play-icon');
  const statusEl = document.getElementById('sim-status');

  if (!simRouteSteps.length) {
    if (statusEl) statusEl.textContent = 'No route geodata for this case';
    return;
  }

  if (isSimulating) {
    clearInterval(simInterval);
    isSimulating = false;
    if (icon) icon.textContent = '▶';
    if (statusEl) statusEl.textContent = 'Playback Paused';
  } else {
    isSimulating = true;
    if (icon) icon.textContent = '⏸';

    if (!simMarker && leafletMap) {
      simMarker = L.circleMarker([simRouteSteps[0].lat, simRouteSteps[0].lng], {
        radius: 8,
        color: '#FF4757',
        fillColor: '#FFFFFF',
        fillOpacity: 1,
        weight: 3
      }).addTo(leafletMap);
    }

    simInterval = setInterval(() => {
      const step = simRouteSteps[simIndex];
      if (simMarker && leafletMap) {
        simMarker.setLatLng([step.lat, step.lng]);
        leafletMap.flyTo([step.lat, step.lng], 12, { duration: 0.8 });
      }
      if (statusEl) {
        statusEl.textContent = `SIMULATION [${simIndex + 1}/${simRouteSteps.length}]: ${step.t} — ${step.note}`;
      }
      simIndex = (simIndex + 1) % simRouteSteps.length;
    }, 2200);
  }
}

