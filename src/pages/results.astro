// Full Final Investigation Dossier Print Handler
function printFullDossier() {
  close65BModal();
  
  document.body.classList.remove('print-mode-certificate');
  document.body.classList.add('print-mode-dossier');

  // Use rAF to ensure the class is painted before triggering print
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      window.print();
    });
  });
  // Clean up after the print dialog closes (works in all modern browsers)
  function cleanup() {
    document.body.classList.remove('print-mode-dossier');
    window.removeEventListener('afterprint', cleanup);
  }
  window.addEventListener('afterprint', cleanup);
  // Fallback cleanup if afterprint never fires (e.g. some older browsers)
  setTimeout(() => { document.body.classList.remove('print-mode-dossier'); }, 10000);
}

// 65B Certificate Print Handler
function print65BCertificate() {
  document.body.classList.remove('print-mode-dossier');
  document.body.classList.add('print-mode-certificate');

  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      window.print();
    });
  });
  function cleanup() {
    document.body.classList.remove('print-mode-certificate');
    window.removeEventListener('afterprint', cleanup);
  }
  window.addEventListener('afterprint', cleanup);
  setTimeout(() => { document.body.classList.remove('print-mode-certificate'); }, 10000);
}

