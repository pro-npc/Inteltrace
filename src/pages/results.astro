async function toggleCaseStatus(id, currentStatus) {
  const newStatus = currentStatus === 'CLOSED' ? 'ACTIVE' : 'CLOSED';
  if (!confirm(`Are you sure you want to ${newStatus === 'CLOSED' ? 'close' : 'reopen'} this case?`)) return;
  try {
    const res = await fetch(`/api/cases/${encodeURIComponent(id)}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: newStatus })
    });
    if (res.ok) window.location.reload();
    else alert('Failed to update case status');
  } catch (err) { alert('An error occurred'); }
}

async function deleteCase(id) {
  if (!confirm('WARNING: Are you sure you want to permanently delete this case? This action cannot be undone.')) return;
  try {
    const res = await fetch(`/api/cases/${encodeURIComponent(id)}`, { method: 'DELETE' });
    if (res.ok) window.location.href = '/history';
    else alert('Failed to delete case');
  } catch (err) { alert('An error occurred'); }
}

