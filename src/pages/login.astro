---
import Layout from '../layouts/Layout.astro';
---

<Layout title="IntelTrace — Secure Login">
  <div class="login-shell">
    <!-- Left Panel: Brand -->
    <div class="login-brand">
      <div class="brand-glows" aria-hidden="true">
        <div class="brand-glow-1"></div>
        <div class="brand-glow-2"></div>
      </div>

      <div class="brand-content">
        <div class="brand-badge">MINISTRY OF HOME AFFAIRS · CYBER CRIME INVESTIGATION UNIT</div>

        <div class="brand-logo">
          <div class="logo-mark" style="width:40px;height:40px;border-radius:10px">
            <svg width="24" height="24" viewBox="0 0 40 40" fill="none">
              <circle cx="20" cy="20" r="18" stroke="#00D4FF" stroke-width="1.5" stroke-opacity="0.35"/>
              <circle cx="17" cy="17" r="7" stroke="#00D4FF" stroke-width="2"/>
              <line x1="22.5" y1="22.5" x2="28.5" y2="28.5" stroke="#00D4FF" stroke-width="2.5" stroke-linecap="round"/>
              <circle cx="17" cy="17" r="2.5" fill="#00D4FF"/>
              <circle cx="8" cy="20" r="1.5" fill="#00D4FF" fill-opacity="0.45"/>
              <circle cx="32" cy="20" r="1.5" fill="#00D4FF" fill-opacity="0.45"/>
              <circle cx="20" cy="8"  r="1.5" fill="#00D4FF" fill-opacity="0.45"/>
            </svg>
          </div>
          <div>
            <div class="brand-name">IntelTrace</div>
            <div class="brand-tagline">Digital Forensics Intelligence Platform</div>
          </div>
        </div>

        <h1 class="brand-headline">
          Unified<br />
          <span class="brand-headline-accent">Investigative</span><br />
          Intelligence
        </h1>

        <p class="brand-desc">
          Correlate CDR, IPDR, bank statement, social media, and blockchain data. 
          Our 6-way AI correlation engine uncovers what no single source can reveal.
        </p>

        <div class="brand-stats">
          <div class="brand-stat">
            <div class="brand-stat-val">5 Vectors</div>
            <div class="brand-stat-lbl">Multi-Stream Ingestion</div>
          </div>
          <div class="brand-stat-divider"></div>
          <div class="brand-stat">
            <div class="brand-stat-val">6-Way</div>
            <div class="brand-stat-lbl">Forensic Correlation</div>
          </div>
          <div class="brand-stat-divider"></div>
          <div class="brand-stat">
            <div class="brand-stat-val">§65B</div>
            <div class="brand-stat-lbl">Certified Integrity</div>
          </div>
        </div>

        <div class="security-badges">
          <div class="sec-badge">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            AES-256 Encrypted
          </div>
          <div class="sec-badge">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            MFA Enforced
          </div>
          <div class="sec-badge">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Full Audit Log
          </div>
        </div>
      </div>
    </div>

    <!-- Right Panel: Login Form -->
    <div class="login-form-panel">
      <div class="login-form-wrap" id="login-step-1">
        <div class="form-eyebrow">SECURE ACCESS</div>
        <h2 class="form-title">Investigator Login</h2>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
          <p class="form-desc" style="margin:0">Authorized personnel only. All access is logged and audited.</p>
          <button type="button" onclick="fillDemoLogin()" style="background:rgba(0,212,255,0.08);border:1px solid rgba(0,212,255,0.2);color:var(--cyan);border-radius:6px;padding:3px 8px;font-size:0.62rem;font-family:'DM Mono',monospace;cursor:pointer;white-space:nowrap;transition:all 0.2s" onmouseover="this.style.background='rgba(0,212,255,0.18)'" onmouseout="this.style.background='rgba(0,212,255,0.08)'">Demo Credentials</button>
        </div>

        <form id="login-form" class="form-body" onsubmit="handleLogin(event)">
          <div class="field-group">
            <label class="field-label" for="badge-id">Badge ID / Email Address</label>
            <div class="field-input-wrap">
              <div class="field-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
              <input
                id="badge-id"
                type="text"
                class="field-input"
                maxlength="80"
                placeholder="e.g. inspector@cybercrime.gov.in"
                autocomplete="username"
              />
            </div>
          </div>

          <div class="field-group">
            <label class="field-label" for="password">Password</label>
            <div class="field-input-wrap">
              <div class="field-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </div>
              <input
                id="password"
                type="password"
                class="field-input"
                maxlength="64"
                placeholder="Enter password"
                autocomplete="current-password"
              />
              <button type="button" class="field-toggle" id="pwd-toggle">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <div class="auth-error hidden" id="login-error" role="alert"></div>

          <button type="submit" class="login-btn" id="login-submit">
            <span id="btn-text">Authenticate & Proceed to MFA</span>
            <div class="btn-arrow">→</div>
          </button>
        </form>
      </div>

      <!-- MFA Step -->
      <div class="login-form-wrap hidden" id="login-step-2">
        <div class="form-eyebrow">MFA VERIFICATION</div>
        <h2 class="form-title">Two-Factor Authentication</h2>
        <p class="form-desc">Enter the 6-digit TOTP code from your authenticator app.</p>

        <div class="mfa-method-row">
          <button class="mfa-method active" id="mfa-totp">📱 Authenticator App</button>
        </div>

        <div class="mfa-code-row" id="mfa-inputs">
          {[0,1,2,3,4,5].map(i => (
            <input
              type="text"
              maxlength="1"
              class="mfa-digit"
              id={`mfa-${i}`}
              inputmode="numeric"
              pattern="[0-9]"
              autocomplete="off"
            />
          ))}
        </div>

        <div class="mfa-resend-row">
          <span class="mfa-resend-text">Didn't receive the code?</span>
          <button class="mfa-resend-btn" id="resend-btn">Resend Code</button>
          <span class="mfa-timer" id="mfa-timer">29s</span>
        </div>

        <div class="auth-error hidden" id="mfa-error" role="alert"></div>

        <button class="login-btn" id="mfa-submit" onclick="handleMFA()">
          <span>Verify & Enter Platform</span>
          <div class="btn-arrow">→</div>
        </button>

        <button class="back-btn" onclick="showStep1()">← Back to Login</button>
      </div>

      <div class="login-footer">
        <span>© 2024 Ministry of Home Affairs, India</span>
        <span>·</span>
        <span>RESTRICTED SYSTEM — Unauthorized access is a criminal offence</span>
      </div>
    </div>
  </div>
</Layout>

<style>
.login-shell {
  display: flex;
  min-height: 100dvh;
}

/* Left Brand Panel */
.login-brand {
  flex: 1;
  position: relative;
  background: var(--bg-surface);
  border-right: 1px solid var(--border-dim);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60px 48px;
  overflow: hidden;
}

.brand-glows {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.brand-glow-1 {
  position: absolute;
  top: -20%;
  left: -10%;
  width: 60%;
  height: 60%;
  background: radial-gradient(ellipse, rgba(6,182,212,0.06) 0%, transparent 70%);
}

.brand-glow-2 {
  position: absolute;
  bottom: -10%;
  right: -10%;
  width: 50%;
  height: 50%;
  background: radial-gradient(ellipse, rgba(139,92,246,0.06) 0%, transparent 70%);
}

.brand-content {
  position: relative;
  z-index: 1;
  max-width: 480px;
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.brand-badge {
  font-size: 0.58rem;
  font-family: 'DM Mono', monospace;
  color: var(--text-dim);
  letter-spacing: 0.1em;
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--border-dim);
  border-radius: 4px;
  padding: 5px 10px;
  display: inline-block;
}

.brand-logo {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-logo-icon {
  width: 58px;
  height: 58px;
  background: rgba(6,182,212,0.12);
  border: 1px solid rgba(6,182,212,0.3);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 0 24px -6px rgba(6,182,212,0.3);
}

.brand-name {
  font-size: 1.6rem;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.04em;
}

.brand-tagline {
  font-size: 0.68rem;
  color: var(--text-dim);
  margin-top: 2px;
}

.brand-headline {
  font-size: 3rem;
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.04em;
  color: var(--text-primary);
}

.brand-headline-accent {
  color: var(--accent-cyan);
}

.brand-desc {
  font-size: 0.84rem;
  color: var(--text-secondary);
  line-height: 1.65;
}

.brand-stats {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 16px 20px;
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--border-dim);
  border-radius: 12px;
}

.brand-stat-val {
  font-size: 1.4rem;
  font-weight: 700;
  font-family: 'DM Mono', monospace;
  color: var(--accent-cyan);
  letter-spacing: -0.03em;
}

.brand-stat-lbl {
  font-size: 0.62rem;
  color: var(--text-dim);
  margin-top: 2px;
}

.brand-stat-divider {
  width: 1px;
  height: 36px;
  background: var(--border-dim);
}

.security-badges {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.sec-badge {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.65rem;
  font-family: 'DM Mono', monospace;
  color: #34D399;
  background: rgba(16,185,129,0.08);
  border: 1px solid rgba(16,185,129,0.2);
  border-radius: 6px;
  padding: 5px 10px;
}

/* Right Form Panel */
.login-form-panel {
  width: 480px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48px 40px;
  position: relative;
}

.login-form-wrap {
  width: 100%;
  max-width: 380px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.hidden { display: none; }

.form-eyebrow {
  font-size: 0.6rem;
  font-family: 'DM Mono', monospace;
  color: var(--accent-cyan);
  letter-spacing: 0.12em;
  background: rgba(6,182,212,0.08);
  border: 1px solid rgba(6,182,212,0.2);
  border-radius: 4px;
  padding: 4px 10px;
  display: inline-block;
  width: fit-content;
}

.form-title {
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.03em;
}

.form-desc {
  font-size: 0.76rem;
  color: var(--text-dim);
  margin-top: -8px;
}

.form-body {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.field-label {
  font-size: 0.7rem;
  font-weight: 500;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
}

.field-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.field-icon {
  position: absolute;
  left: 12px;
  color: var(--text-dim);
  display: flex;
  align-items: center;
  pointer-events: none;
}

.field-input {
  width: 100%;
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--border-base);
  border-radius: 10px;
  padding: 11px 12px 11px 38px;
  color: var(--text-primary);
  font-size: 0.82rem;
  font-family: 'Space Grotesk', sans-serif;
  outline: none;
  transition: all 0.2s;
}

.field-input:focus {
  border-color: rgba(6,182,212,0.5);
  background: rgba(6,182,212,0.04);
  box-shadow: 0 0 0 3px rgba(6,182,212,0.1);
}

.field-input::placeholder { color: var(--text-dim); }

.field-toggle {
  position: absolute;
  right: 12px;
  background: none;
  border: none;
  color: var(--text-dim);
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  transition: color 0.2s;
}

.field-toggle:hover { color: var(--text-secondary); }

.login-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(6,182,212,0.15);
  border: 1px solid rgba(6,182,212,0.4);
  color: var(--accent-cyan);
  border-radius: 10px;
  padding: 13px 18px;
  font-size: 0.84rem;
  font-weight: 600;
  font-family: 'Space Grotesk', sans-serif;
  cursor: pointer;
  transition: all 0.25s var(--transition-smooth);
  margin-top: 4px;
}

.login-btn:hover {
  background: rgba(6,182,212,0.22);
  border-color: rgba(6,182,212,0.65);
  box-shadow: 0 0 24px -6px rgba(6,182,212,0.4);
  transform: translateY(-1px);
}

.login-btn:active { transform: scale(0.98); }

.btn-arrow {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: rgba(6,182,212,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
  transition: transform 0.2s;
}

.login-btn:hover .btn-arrow { transform: translateX(2px); }

.demo-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  text-decoration: none;
  font-size: 0.74rem;
  color: var(--text-dim);
  transition: color 0.2s;
  padding: 4px;
}

.demo-link:hover { color: var(--accent-cyan); }

/* MFA */
.mfa-method-row {
  display: flex;
  gap: 6px;
}

.mfa-method {
  flex: 1;
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--border-dim);
  border-radius: 8px;
  padding: 8px 4px;
  font-size: 0.65rem;
  color: var(--text-dim);
  cursor: pointer;
  transition: all 0.2s;
  text-align: center;
  font-family: 'Space Grotesk', sans-serif;
}

.mfa-method.active {
  background: rgba(6,182,212,0.1);
  border-color: rgba(6,182,212,0.3);
  color: var(--accent-cyan);
}

.mfa-code-row {
  display: flex;
  gap: 8px;
  justify-content: center;
  margin: 4px 0;
}

.mfa-digit {
  width: 46px;
  height: 54px;
  text-align: center;
  font-size: 1.4rem;
  font-family: 'DM Mono', monospace;
  font-weight: 700;
  color: var(--text-primary);
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border-base);
  border-radius: 10px;
  outline: none;
  transition: all 0.2s;
  caret-color: var(--accent-cyan);
}

.mfa-digit:focus {
  border-color: rgba(6,182,212,0.6);
  background: rgba(6,182,212,0.06);
  box-shadow: 0 0 0 3px rgba(6,182,212,0.12);
}

.mfa-resend-row {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.72rem;
}

.mfa-resend-text { color: var(--text-dim); }

.mfa-resend-btn {
  background: none;
  border: none;
  color: var(--accent-cyan);
  cursor: pointer;
  font-size: 0.72rem;
  text-decoration: underline;
  font-family: 'Space Grotesk', sans-serif;
}

.mfa-timer {
  font-family: 'DM Mono', monospace;
  font-size: 0.7rem;
  color: var(--accent-amber);
  margin-left: auto;
}

.back-btn {
  background: none;
  border: none;
  color: var(--text-dim);
  cursor: pointer;
  font-size: 0.74rem;
  font-family: 'Space Grotesk', sans-serif;
  text-align: center;
  transition: color 0.2s;
}
.back-btn:hover { color: var(--text-secondary); }

.login-footer {
  position: absolute;
  bottom: 20px;
  display: flex;
  gap: 8px;
  font-size: 0.6rem;
  color: var(--text-dim);
  text-align: center;
  flex-wrap: wrap;
  justify-content: center;
  padding: 0 20px;
}

@media (max-width: 900px) {
  .login-shell { flex-direction: column; }
  .login-brand { padding: 40px 24px; }
  .login-form-panel { width: 100%; padding: 32px 24px; }
  .brand-headline { font-size: 2rem; }
}

.auth-error {
  margin: 4px 0 2px;
  padding: 10px 14px;
  border-radius: 10px;
  background: rgba(220, 38, 38, 0.08);
  border: 1px solid rgba(220, 38, 38, 0.35);
  color: #fca5a5;
  font-size: 0.82rem;
  line-height: 1.4;
  letter-spacing: 0.01em;
}
.auth-error.hidden { display: none; }
.login-btn.is-busy { opacity: 0.65; pointer-events: none; }
</style>

<script is:inline>
function showError(id, msg) {
  const el = document.getElementById(id);
  if (!el) return;
  el.textContent = msg;
  el.classList.remove('hidden');
}
function hideError(id) {
  const el = document.getElementById(id);
  if (el) el.classList.add('hidden');
}
function setBusy(btnId, textId, busy, busyText, idleText) {
  const btn = document.getElementById(btnId);
  const txt = textId ? document.getElementById(textId) : null;
  if (btn) btn.classList.toggle('is-busy', busy);
  if (txt) txt.textContent = busy ? busyText : idleText;
}

async function handleLogin(e) {
  e.preventDefault();
  hideError('login-error');
  const badgeId = document.getElementById('badge-id').value.trim();
  const password = document.getElementById('password').value;
  if (!badgeId || !password) {
    showError('login-error', 'Enter your badge ID and password.');
    return;
  }
  setBusy('login-submit', 'btn-text', true, 'Authenticating…', 'Authenticate & Proceed to MFA');
  try {
    const res = await fetch('/api/auth/login', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ badgeId, password }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || !data.ok) {
      showError('login-error', data.error || 'Invalid credentials. Please try again.');
      setBusy('login-submit', 'btn-text', false, '', 'Authenticate & Proceed to MFA');
      return;
    }
    // Credentials accepted → reveal MFA step.
    setBusy('login-submit', 'btn-text', false, '', 'Authenticate & Proceed to MFA');
    document.getElementById('login-step-1').classList.add('hidden');
    document.getElementById('login-step-2').classList.remove('hidden');
    setTimeout(() => { document.getElementById('mfa-0').focus(); }, 100);
    startMFATimer();
  } catch (err) {
    showError('login-error', 'Network error — could not reach the server.');
    setBusy('login-submit', 'btn-text', false, '', 'Authenticate & Proceed to MFA');
  }
}

function showStep1() {
  document.getElementById('login-step-2').classList.add('hidden');
  document.getElementById('login-step-1').classList.remove('hidden');
  hideError('mfa-error');
  clearInterval(timerInterval);
}

let mfaSubmitting = false;
async function handleMFA() {
  if (mfaSubmitting) return;
  hideError('mfa-error');
  const code = Array.from({ length: 6 }, (_, j) => document.getElementById(`mfa-${j}`).value).join('');
  if (code.length !== 6) {
    showError('mfa-error', 'Enter all 6 digits.');
    return;
  }
  mfaSubmitting = true;
  setBusy('mfa-submit', null, true);
  try {
    const res = await fetch('/api/auth/mfa', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ code }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || !data.ok) {
      showError('mfa-error', data.error || 'Invalid authentication code.');
      for (let j = 0; j < 6; j++) document.getElementById(`mfa-${j}`).value = '';
      document.getElementById('mfa-0').focus();
      mfaSubmitting = false;
      setBusy('mfa-submit', null, false);
      return;
    }
    // Full session established → enter platform.
    window.location.href = '/';
  } catch (err) {
    showError('mfa-error', 'Network error — could not reach the server.');
    mfaSubmitting = false;
    setBusy('mfa-submit', null, false);
  }
}

let timerInterval;
function startMFATimer() {
  clearInterval(timerInterval);
  let seconds = 29;
  const timerEl = document.getElementById('mfa-timer');
  if (timerEl) timerEl.textContent = `${seconds}s`;
  timerInterval = setInterval(() => {
    seconds--;
    if (timerEl) timerEl.textContent = `${seconds}s`;
    if (seconds <= 0) {
      clearInterval(timerInterval);
      if (timerEl) timerEl.textContent = 'Expired';
    }
  }, 1000);
}

// MFA digit auto-advance
document.addEventListener('DOMContentLoaded', () => {
  for (let i = 0; i < 6; i++) {
    const el = document.getElementById(`mfa-${i}`);
    if (!el) continue;
    el.addEventListener('input', (e) => {
      const val = e.target.value.replace(/\D/g, '');
      e.target.value = val.slice(-1);
      if (val && i < 5) {
        document.getElementById(`mfa-${i+1}`).focus();
      }
      // Auto-submit if all 6 filled
      const allFilled = Array.from({length: 6}, (_, j) => document.getElementById(`mfa-${j}`).value).every(v => v.length === 1);
      if (allFilled) {
        setTimeout(handleMFA, 400);
      }
    });
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !el.value && i > 0) {
        document.getElementById(`mfa-${i-1}`).focus();
      }
    });
  }

  // Password toggle
  const toggleBtn = document.getElementById('pwd-toggle');
  const pwdInput = document.getElementById('password');
  if (toggleBtn && pwdInput) {
    toggleBtn.addEventListener('click', () => {
      pwdInput.type = pwdInput.type === 'password' ? 'text' : 'password';
    });
  }
});

function fillDemoLogin() {
  const b = document.getElementById('badge-id');
  const p = document.getElementById('password');
  if (b) b.value = 'inspector@cybercrime.gov.in';
  if (p) p.value = 'demo_secure_2024';
}
