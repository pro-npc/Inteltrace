---
interface Props {
  activePage?: string;
  threatLevel?: string;
  officerName?: string;
  officerRole?: string;
}
const {
  activePage = 'dashboard',
  threatLevel = 'MONITORED',
  officerName = 'Insp. S. Mehta',
  officerRole = 'Senior Investigator',
} = Astro.props;

const threatColor =
  threatLevel === 'CRITICAL' || threatLevel === 'HIGH'
    ? '#FF4757'
    : threatLevel === 'ELEVATED' || threatLevel === 'MEDIUM'
      ? '#FFB300'
      : threatLevel === 'STANDBY'
        ? '#64748b'
        : '#00E676';

const initials = officerName
  .split(' ')
  .filter(Boolean)
  .map(w => w[0].toUpperCase())
  .join('')
  .slice(-2) || 'IN';

const nav = [
  { id: 'dashboard',     href: '/',                  label: 'Intelligence Hub',  chip: 'live' },
  { id: 'investigation', href: '/new-investigation',  label: 'New Investigation', chip: 'new' },
  { id: 'results',       href: '/results',            label: 'Case Results',      chip: null, dynId: 'sidebar-results-link' },
  { id: 'history',       href: '/history',            label: 'Case Registry',     chip: null },
];
---

<aside class="sidebar">
  <!-- Logo -->
  <div class="logo-area">
    <div class="logo-mark">
      <svg width="20" height="20" viewBox="0 0 40 40" fill="none">
        <circle cx="20" cy="20" r="18" stroke="#8AABFF" stroke-width="1.5" stroke-opacity="0.35"/>
        <circle cx="17" cy="17" r="7" stroke="#8AABFF" stroke-width="2"/>
        <line x1="22.5" y1="22.5" x2="28.5" y2="28.5" stroke="#8AABFF" stroke-width="2.5" stroke-linecap="round"/>
        <circle cx="17" cy="17" r="2.5" fill="#8AABFF"/>
        <circle cx="8" cy="20" r="1.5" fill="#8AABFF" fill-opacity="0.45"/>
        <circle cx="32" cy="20" r="1.5" fill="#8AABFF" fill-opacity="0.45"/>
        <circle cx="20" cy="8"  r="1.5" fill="#8AABFF" fill-opacity="0.45"/>
        <line x1="9.5" y1="20" x2="12.5" y2="20" stroke="#8AABFF" stroke-width="0.8" stroke-opacity="0.35"/>
        <line x1="27.5" y1="20" x2="30.5" y2="20" stroke="#8AABFF" stroke-width="0.8" stroke-opacity="0.35"/>
        <line x1="20" y1="9.5"  x2="20" y2="12.5"  stroke="#8AABFF" stroke-width="0.8" stroke-opacity="0.35"/>
      </svg>
    </div>
    <div class="logo-text">
      <span class="logo-name">IntelTrace</span>
      <span class="logo-sub">Forensics Platform</span>
    </div>
  </div>

  <!-- Nav -->
  <nav class="nav-group">
    <div class="nav-label">Platform</div>
    {nav.map(n => (
      <a href={n.href} id={n.dynId || undefined} class={`nav-item ${activePage === n.id ? 'active' : ''}`}>
        <span class="nav-icon">
          {n.id === 'dashboard' && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>}
          {n.id === 'investigation' && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>}
          {n.id === 'results' && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>}
          {n.id === 'history' && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="2" y1="10" x2="22" y2="10"/></svg>}
        </span>
        {n.label}
        {n.chip === 'live' && <span class="nav-chip chip-live">LIVE</span>}
        {n.chip === 'new'  && <span class="nav-chip chip-new">NEW</span>}
      </a>
    ))}
  </nav>

  <!-- Footer -->
  <div class="officer-footer">
    <div class="officer-card">
      <div class="officer-av">{initials}</div>
      <div>
        <div class="officer-name">{officerName}</div>
        <div class="officer-role">{officerRole}</div>
      </div>
      <div style="display:flex;align-items:center;">
        <button type="button" onclick="toggleTheme()" class="logout-icon" title="Toggle Light/Dark Mode" style="background:none;border:none;padding:0;margin-right:12px;cursor:pointer;display:flex;align-items:center">
          <svg id="theme-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </button>
      <button type="button" onclick="fetch('/api/auth/logout', {method:'POST'}).finally(function(){window.location.href='/login';})" class="logout-icon" title="Logout" style="background:none;border:none;padding:0;cursor:pointer;display:flex;align-items:center">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      </button>
      </div>
    </div>
    <div class="build-tag">v1.0 · ZERO-TRUST FORENSICS ENGINE</div>
  </div>
</aside>

<script is:inline>
  // Setup theme
  function initTheme() {
    const isLight = localStorage.getItem('inteltrace_theme') === 'light';
    if (isLight) document.documentElement.classList.add('light-theme');
  }
  function toggleTheme() {
    const isLight = document.documentElement.classList.toggle('light-theme');
    localStorage.setItem('inteltrace_theme', isLight ? 'light' : 'dark');
  }
  initTheme();
</script>

<script is:inline>
(function () {
  var last = localStorage.getItem('inteltrace_last_case');
  if (last) {
    var el = document.getElementById('sidebar-results-link');
    if (el) el.href = '/results?case=' + encodeURIComponent(last);
  }
})();
</script>
